# --- secrets: never commit (architecture §20.3) -----------------------------
.env
.env.*
*.key
*.pem
secrets/

# --- per-environment runtime state (architecture §20.1) ---------------------
# Anchored to the repo root. Unanchored, these also matched src/okxq/data/ and
# src/okxq/audit/, so the M1 pipeline and the M0 audit chain were never committed.
/state/
/data/
/audit/
/logs/

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- os ---------------------------------------------------------------------
Thumbs.db
desktop.ini
